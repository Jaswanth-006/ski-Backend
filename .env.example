# Copy to .env for local dev. NEVER commit a real .env.
# Phase 0-A only needs these; the full catalog (DB, Redis, JWT, object storage,
# LLM/STT, OTel, Sentry) is documented in 01-BACKEND-PRD §14 and lands per phase.
ENVIRONMENT=dev
APP_NAME=ski-backend
VERSION=0.1.0

# Database (Phase 0-B). Matches docker-compose.yml. Replica falls back to primary when unset.
DATABASE_URL=postgresql+asyncpg://ski:ski@localhost:5432/ski
# DATABASE_REPLICA_URL=postgresql+asyncpg://ski:ski@localhost:5432/ski

# Seed super_admin (created by the seed migration). Rotate the password after first login.
SEED_ADMIN_NAME=R. Kamala
SEED_ADMIN_PHONE=9000000001
SEED_ADMIN_PASSWORD=ChangeMe@123

# Auth (Phase 0-C). Generate a strong secret for real environments, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-secret-change-me-min-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Observability (Phase 0-D). Sentry stays off unless SENTRY_DSN is set.
LOG_LEVEL=INFO
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0
