# Copy to .env for local dev. NEVER commit a real .env.
# Full config catalog: 01-BACKEND-PRD §14. Production values: see DEPLOYMENT.md.
ENVIRONMENT=dev
APP_NAME=ski-backend
VERSION=0.1.0

# Database (Phase 0-B). Matches docker-compose.yml. Replica falls back to primary when unset.
# Production (Neon) — keep the asyncpg driver + SSL:
#   DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql+asyncpg://ski:ski@localhost:5432/ski
# DATABASE_REPLICA_URL=postgresql+asyncpg://ski:ski@localhost:5432/ski

# Seed super_admin (created by the seed migration). Rotate the password after first login.
SEED_ADMIN_NAME=R. Kamala
SEED_ADMIN_PHONE=9000000001
SEED_ADMIN_PASSWORD=ChangeMe@123

# Auth (Phase 0-C). Generate a strong secret for real environments, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-secret-change-me-min-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Deployment (Phase 7-E). Comma-separated web origins allowed by CORS (the web app runs on a
# different origin in production, e.g. https://your-app.vercel.app).
CORS_ORIGINS=http://localhost:5173

# Security hardening (Phase 7-B). Login brute-force throttle (Redis-backed, fail-open).
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Observability (Phase 0-D / 7-D). Sentry stays off unless SENTRY_DSN is set; /metrics is always on.
LOG_LEVEL=INFO
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0

# Redis / Celery (Phase 0-F). Broker + backend default to REDIS_URL.
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# Object storage (Phase 0-F) — MinIO locally (docker-compose). OPTIONAL in production: the day
# sheet exports as a direct .xlsx download (GET /v1/day-sheet/{date}/export.xlsx), so no bucket
# is needed for the free deploy. Only required for the async Celery export path (homelab).
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=ski
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_REGION=us-east-1
PRESIGN_TTL_SECONDS=3600
